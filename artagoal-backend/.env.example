# Contoh environment untuk interpolasi docker-compose.yml. Salin menjadi `.env`:
#   Copy-Item .env.example .env
# Lalu isi nilai ASLI (file .env tidak masuk git).

# Secret HMAC bersama auth-service & goal-service.
# Buat baru: openssl rand -base64 48
# PENTING: jangan memakai nilai default untuk deployment produksi.
JWT_SECRET=ganti-dengan-minimal-32-karakter-acak

# Kunci VAPID untuk Web Push (goal-service). Tanpa ini push nonaktif.
# Buat baru dari dalam services/goal-service:
#   go run ./tmpvapid  (lihat README bagian Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@artagoal.local
