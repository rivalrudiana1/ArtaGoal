# Contoh konfigurasi goal-service. Salin menjadi `.env`:
#   Copy-Item .env.example .env
# Lalu isi nilai ASLI (file .env tidak masuk git).

# Alamat HTTP goal-service.
HTTP_ADDR=:8080

# Koneksi PostgreSQL. Contoh lokal via docker compose:
DATABASE_URL=postgresql://user:password@localhost:5432/artagoal?sslmode=disable
# Contoh Supabase:
# DATABASE_URL=postgresql://postgres.USER:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Secret HMAC untuk verifikasi JWT (minimal 32 karakter acak).
# WAJIB sama dengan JWT_SECRET di auth-service agar token lintas service valid.
# Buat baru: openssl rand -base64 48
JWT_SECRET=ganti-dengan-minimal-32-karakter-acak
